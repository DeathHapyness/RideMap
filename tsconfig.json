{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": false,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["server.ts", "routes/**/*.ts", "controllers/**/*.ts", "models/**/*.ts", "middlewares/**/*.ts", "services/**/*.ts", "db/**/*.ts", "config/**/*.ts", "types/**/*.d.ts"],
  "exclude": ["node_modules", "dist", "public"]
}
